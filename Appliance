import java.util.*;

interface SaverMode {
    default double applySaver(double units) {
        return units * 0.75;
    }
}

abstract class Appliance {
    double hours;

    Appliance(double hours) {
        this.hours = hours;
    }

    abstract double getPower();

    double getUnits() {
        return getPower() * hours / 1000.0;
    }

    double getCost() {
        return getUnits() * 8.0;
    }
}

class Fridge extends Appliance {
    Fridge(double hours) {
        super(hours);
    }

    double getPower() {
        return 150.0;
    }
}

class AC extends Appliance implements SaverMode {
    boolean saver;

    AC(double hours, boolean saver) {
        super(hours);
        this.saver = saver;
    }

    double getPower() {
        return 1500.0;
    }

    double getUnits() {
        double units = super.getUnits();
        return saver ? applySaver(units) : units;
    }
}

class TV extends Appliance {
    TV(double hours) {
        super(hours);
    }

    double getPower() {
        return 100.0;
    }
}

class Washer extends Appliance implements SaverMode {
    boolean saver;

    Washer(double hours, boolean saver) {
        super(hours);
        this.saver = saver;
    }

    double getPower() {
        return 500.0;
    }

    double getUnits() {
        double units = super.getUnits();
        return saver ? applySaver(units) : units;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Appliance[] appliances = new Appliance[n];
        String[] names = new String[n];
        boolean[] saver = new boolean[n];
        double totalCost = 0;

        for (int i = 0; i < n; i++) {
            names[i] = sc.next();
            double hours = sc.nextDouble();

            saver[i] = sc.hasNext("SAVER");
            if (saver[i]) {
                sc.next();
            }

            switch (names[i]) {
                case "FRIDGE":
                    appliances[i] = new Fridge(hours);
                    break;
                case "AC":
                    appliances[i] = new AC(hours, saver[i]);
                    break;
                case "TV":
                    appliances[i] = new TV(hours);
                    break;
                case "WASHER":
                    appliances[i] = new Washer(hours, saver[i]);
                    break;
            }
        }

        for (int i = 0; i < n; i++) {
            Appliance a = appliances[i];

            if (saver[i] && !(a instanceof SaverMode)) {
                System.out.println(
                    names[i] + ": saver mode not supported");
                continue;
            }

            double units = a.getUnits();
            double cost = a.getCost();

            System.out.printf(
                "%s: Units=%.2f Cost=%.2f%n",
                names[i], units, cost
            );

            totalCost += cost;
        }

        System.out.printf("Total Cost: %.2f%n", totalCost);
        sc.close();
    }
}
